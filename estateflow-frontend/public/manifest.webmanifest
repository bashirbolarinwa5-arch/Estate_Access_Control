{
  "id": "/",
  "name": "EstateFlow — Estate Access Control",
  "short_name": "EstateFlow",
  "description": "Manage residents, visitors, visits and security access for your estate.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "background_color": "#0b1020",
