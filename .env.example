# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------

# PostgreSQL password (used by the db service AND the backend)
DB_PASSWORD=change-me-strong-password

# JWT signing secret — must be base64, at least 32 bytes.
# Generate a fresh one for each environment:
#   openssl rand -base64 64
JWT_SECRET=

# ---------------------------------------------------------
# SERVER / DOMAIN SETTINGS
# ---------------------------------------------------------

# Port the web app is published on.
# 80  → users browse http://<SERVER_IP> directly (VPS deploy)
# 5173 → typical local Docker testing
WEB_PORT=80

# Where users' BROWSERS can reach the API. This value is
# baked into the frontend bundle at build time.
#   VPS (no domain):   http://<SERVER_IP>:8081
#   with domain:       https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8081

# Browser origins allowed to call the API (comma-separated,
# no trailing slash). This must match where the WEB APP is
# browsed from:
#   VPS (no domain):   http://<SERVER_IP>
#   with domain:       https://app.your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost
