# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------

# PostgreSQL password (used by the db service AND the backend)
DB_PASSWORD=change-me-strong-password

# JWT signing secret — must be base64, at least 32 bytes.
# Generate a fresh one for each environment:
#   openssl rand -base64 64
JWT_SECRET=

# ---------------------------------------------------------
# CORS — which browser origins may call the API
# ---------------------------------------------------------

# The ORIGIN of the frontend. The production frontend lives on
# Vercel — put its URL here (comma-separated, no trailing slash).
# Origin patterns are supported (credential-safe), so:
#   https://estateflow.vercel.app            ← your production URL
#   https://estateflow.vercel.app,https://*.vercel.app  ← + preview URLs
# Local dev default:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional background push alerts (use one persistent VAPID key pair).
APP_FRONTEND_URL=https://estate-access-control-phi.vercel.app
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:support@estateflow.ng

# Optional Termii SMS fallback. The account's DND transactional route must be enabled.
TERMII_ENABLED=false
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=

# ---------------------------------------------------------
# EMAIL — password reset links
#
# Reset tokens are delivered ONLY by email; the API never
# returns them. Defaults target the bundled Mailpit sink
# (free, viewable via SSH tunnel on port 8025).
#
# To deliver to real inboxes, use any SMTP provider, e.g.
# Gmail (app password) or Brevo:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<app password>
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   MAIL_FROM=you@gmail.com
# ---------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@estateflow.local
MAIL_FROM_NAME=EstateFlow

# ---------------------------------------------------------
# ONLY for local full-stack Docker testing (docker-compose.yml)
# ---------------------------------------------------------
# The real frontend is hosted on Vercel and needs none of these
# on the server — VITE_API_BASE_URL is set in the Vercel project.

# Port the local web container is published on.
WEB_PORT=5173

# Where users' BROWSERS can reach the API. Baked into the
# frontend bundle at BUILD time.
#   local dev:      http://localhost:8081
#   VPS + domain:   https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8081
