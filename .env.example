# Copy this file to `.env` and fill in real values.
# .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------

# PostgreSQL password (used by the db service AND the backend)
DB_PASSWORD=change-me-strong-password

# JWT signing secret — must be base64, at least 32 bytes.
# Generate a fresh one for each environment:
#   openssl rand -base64 64
JWT_SECRET=

# ---------------------------------------------------------
# CORS — which browser origins may call the API
# ---------------------------------------------------------

# The ORIGIN of the frontend. The production frontend lives on
# Vercel — put its URL here (comma-separated, no trailing slash).
# Origin patterns are supported (credential-safe), so:
#   https://estateflow.vercel.app            ← your production URL
#   https://estateflow.vercel.app,https://*.vercel.app  ← + preview URLs
# Local dev default:
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------
# ONLY for local full-stack Docker testing (docker-compose.yml)
# ---------------------------------------------------------
# The real frontend is hosted on Vercel and needs none of these
# on the server — VITE_API_BASE_URL is set in the Vercel project.

# Port the local web container is published on.
WEB_PORT=5173

# Where users' BROWSERS can reach the API. Baked into the
# frontend bundle at BUILD time.
#   local dev:      http://localhost:8081
#   VPS + domain:   https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8081
